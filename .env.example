# Variáveis do projeto na Vercel (Settings → Environment Variables). Só nomes — nunca valores reais aqui.

# Portal do Corretor (api/portal.js)
BLOB_READ_WRITE_TOKEN=        # store privado "portal-corretores" (criado pela integração Vercel Blob)
PORTAL_CONVITE=               # chave que assina os links de primeiro acesso / nova senha
PORTAL_ADMINS=                # e-mails que podem virar o PRIMEIRO gestor, separados por vírgula
PORTAL_FUSO=America/Asuncion  # fuso comercial das vigências de ofertas (confirmar com o cliente)
PORTAL_SYNC_MIN=5             # intervalo mínimo (min) entre consultas ao CV disparadas pelo portal
PORTAL_DADOS_MAX_MIN=60       # idade máxima (min) do último sucesso para o dado comercial contar como atual
PORTAL_CV_AUTO=               # "1" = corretor novo no CV vira conta e recebe o e-mail sozinho (padrão desligado)
PORTAL_CV_IGNORAR=2           # ids de corretor do CV que nunca viram conta (2 = demonstração "Feira EXPO PY BR")
RESEND_API_KEY=               # chave do Resend (e-mail de boas-vindas)
PORTAL_EMAIL_DE=              # padrão: Bracerum Park <portal@bracerumpark.com>
PORTAL_EMAIL_RESPONDER=       # padrão: bracerumpark@bracerum.com
CRON_SECRET=                  # a Vercel envia no cabeçalho da rotina diária /api/portal?cron=cv-corretores
PORTAL_SEGREDO=               # opcional: chave da sessão (sem ela deriva de ADMIN_SENHA/BLOB/CVCRM)

# CV CRM (api/lotes-status.js, api/lead.js, api/admin.js e o retrato comercial do portal)
CVCRM_EMAIL=
CVCRM_TOKEN=
CVCRM_HOST=bracerum.cvcrm.com.br
CVCRM_EMPREENDIMENTO=4

# Outros
ADMIN_SENHA=                  # painel /admin (não abre mais o portal)
CORRETORES_PLANILHA_URL=      # Apps Script da planilha "Leads Corretores" (/corretores)
